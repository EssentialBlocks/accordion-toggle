# Source maps — dev-only, ~6MB of the archive
*.map export-ignore

# Internal docs, not shipped to wordpress.org
compatibility-report.md export-ignore
CHANGELOG.md export-ignore
CONTRIBUTING.md export-ignore

# Orphaned Font Awesome 4/5 + fontIconPicker webfonts (~3.7MB).
# Nothing references them: the only enqueued icon stylesheet is
# assets/css/fontawesome/css/all.min.css, which resolves to
# assets/css/fontawesome/webfonts/, and dist/*.css inlines
# fontIconPicker as data URIs.
assets/fonts export-ignore

# Editor "controls" bundle (~2.5MB) — built by webpack but never enqueued.
# accordion-toggle.php registers eb-accordion-toggle-controls-util from
# dist/modules.js, not dist/controls.js.
dist/controls.js export-ignore
dist/controls.css export-ignore
dist/controls.asset.php export-ignore
